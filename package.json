{
  "name": "corkboard",
  "version": "1.0.0",
  "description": "Single-file, local-first visual editor for a folder of Markdown notes.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "author": "Andreas Hackel",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahackel/corkboard.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:webkit": "E2E_WEBKIT=1 playwright test --project=webkit",
    "lint": "eslint .",
    "emoji": "node --experimental-strip-types --no-warnings scripts/emoji-names.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:debug": "tauri dev -c src-tauri/tauri.debug.conf.json",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.6",
    "emojibase-data": "18.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.17.1",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^5.0.5"
  }
}
